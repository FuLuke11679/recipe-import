{
  "expo": {
    "name": "RecipeImport",
    "slug": "recipe-import",
    "scheme": "recipeimport",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["android", "web"],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.example.recipeimport",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "www.tiktok.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "recipeimport"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "data": {
            "mimeType": "text/plain"
          },
          "category": ["DEFAULT"]
        }
      ]
    }
  }
}
